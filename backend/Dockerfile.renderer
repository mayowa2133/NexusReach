# Credential-free renderer: TeX exists only in this isolated queue consumer.
FROM python:3.12-slim@sha256:423ed6ab25b1921a477529254bfeeabf5855151dc2c3141699a1bfc852199fbf AS wheels

ENV PIP_NO_CACHE_DIR=1
WORKDIR /build
RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.renderer.lock requirements.renderer.txt ./
RUN pip wheel --no-cache-dir --wheel-dir /wheels -r requirements.renderer.lock

FROM python:3.12-slim@sha256:423ed6ab25b1921a477529254bfeeabf5855151dc2c3141699a1bfc852199fbf

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    NEXUSREACH_SERVICE_ROLE=renderer

WORKDIR /app
# Security packages are upgraded out of the pinned base image on purpose. Debian
# has fixed releases available before the corresponding python:3.12-slim digest
# has been rebuilt. Keep this list aligned with the daily runtime-image scan and
# remove entries once a newer pinned base already contains the fixed release.
RUN groupadd --system nexusreach \
    && useradd --system --gid nexusreach --home-dir /app nexusreach \
    && apt-get update \
    && apt-get install -y --no-install-recommends --only-upgrade \
        util-linux \
        openssl \
        libssl3t64 \
        openssl-provider-legacy \
    && apt-get install -y --no-install-recommends \
        texlive-latex-base \
        texlive-latex-extra \
        texlive-latex-recommended \
        poppler-utils \
    && rm -rf /var/lib/apt/lists/*

COPY --from=wheels /wheels /wheels
COPY requirements.renderer.lock .
RUN pip install --no-index --find-links=/wheels -r requirements.renderer.lock \
    && rm -rf /wheels
RUN mkdir -p /app/app
COPY app/__init__.py ./app/__init__.py
COPY app/renderer_app.py ./app/renderer_app.py
COPY app/renderer_runtime.py ./app/renderer_runtime.py
RUN chown -R nexusreach:nexusreach /app

USER nexusreach
CMD ["celery", "-A", "app.renderer_app:renderer_app", "worker", "--loglevel=info", "--concurrency=1", "-Q", "render"]
